# ---------------------------------------------------------------------------
# PARTIPOLAI — Exemple de configuration (Exigences 28.6, 32.6, 33.1)
# Copier en `.env` et renseigner les valeurs. NE JAMAIS committer de secret.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
APP_ENV=development
APP_DEBUG=true
APP_BASE_URL=http://localhost:8000

# --- Observabilité (journalisation structurée — Exigences 30.1, 26.3) ------
# LOG_LEVEL ∈ {DEBUG, INFO, WARNING, ERROR, CRITICAL}
LOG_LEVEL=INFO
# LOG_FORMAT ∈ {json, console} — `console` = rendu lisible en développement
LOG_FORMAT=json

# --- Base de données (SQLAlchemy 2.x async + psycopg 3 + pgvector) ---------
# Utiliser le driver async psycopg : postgresql+psycopg://
DATABASE_URL=postgresql+psycopg://partipolia:partipolia@localhost:5432/partipolia

# --- Redis (cache, broker Celery, rate limit) ------------------------------
REDIS_URL=redis://localhost:6379/0

# --- JWT (authentification) ------------------------------------------------
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=14

# --- Fournisseur LLM (génération) ------------------------------------------
# LLM_PROVIDER ∈ {openai, anthropic, local}
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_TEMPERATURE=0.1

# --- Fournisseur d'embeddings ----------------------------------------------
# EMBEDDING_PROVIDER ∈ {openai, anthropic, local}
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
EMBEDDING_DIM=1536

# --- RAG (recherche hybride, fusion, reranking, chunking) ------------------
RAG_TOP_K=20
RAG_RERANK_KEEP=6
RAG_CHUNK_SIZE_TOKENS=800
RAG_CHUNK_OVERLAP_TOKENS=120
# Poids de fusion des scores (leur somme doit valoir 1.0 — Property 8)
RAG_WEIGHT_SEMANTIC=0.40
RAG_WEIGHT_LEXICAL=0.30
RAG_WEIGHT_SOURCE_QUALITY=0.20
RAG_WEIGHT_RECENCY=0.10

# --- SMTP (envoi d'e-mails : vérification, notifications) ------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@partipolia.local
SMTP_TLS=false

# --- CORS ------------------------------------------------------------------
# Liste d'origines séparées par des virgules
CORS_ALLOW_ORIGINS=http://localhost:8000,http://localhost:3000
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOW_HEADERS=*
